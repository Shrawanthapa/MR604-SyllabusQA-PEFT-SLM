  "learning_rate": 0.0002,
  "epochs": 3,
  "batch_size": 4,
  "gradient_accumulation": 4,
  "effective_batch": 16,
  "warmup_ratio_design": 0.03,
  "optimizer": "paged_adamw_8bit",
  "qlora_quantization": "4-bit NF4 + double quantisation",
  "metrics": [
    "Exact Match",
    "token-level F1",
    "average inference latency",
    "median inference latency",
    "peak evaluation VRAM",
    "training time",
    "peak training VRAM"
  ],
  "qwen_reference": {
    "zero_shot_context_file": "REF_qwen14b_zeroshot_CONTEXT.json",
    "two_shot_context_file": "REF_qwen14b_2shot_CONTEXT.json"
  }
}