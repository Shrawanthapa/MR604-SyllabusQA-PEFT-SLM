{
  "notebook": "3_Mistral7B_CONTEXT",
  "model": "mistralai/Mistral-7B-Instruct-v0.2",
  "dataset": "SyllabusQA",
  "dataset_split": {
    "train": 3018,
    "validation": 957,
    "test": 1103
  },
  "context_pipeline": {
